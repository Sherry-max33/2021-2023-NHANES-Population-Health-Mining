            patch.set(facecolor=c, edgecolor="white", alpha=0.6, linewidth=1.2)
            bp['whiskers'][2*i + 0].set(color=c, linewidth=1.2)
            bp['whiskers'][2*i + 1].set(color=c, linewidth=1.2)
            bp['caps'][2*i + 0].set(color=c, linewidth=1.2)
